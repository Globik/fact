general: {
	#plugins_folder = "/usr/local/etc/janus"
	plugins_folder = "/usr/local/lib/janus/plugins"
}
certificates: {
	cert_pem = "/etc/janus/certs/fullchain.pem"
	cert_key = "/etc/janus/certs/privkey.pem"
	}
nat: {
	#stun_server = "stun.voip.eutelia.it"
	#stun_port = 3478
	}
events: {
	broadcast = true
	combine_media_stats = false
	disable = "libjanus_wsevh.so,libjanus_gelfevh.so,libjanus_nanomsgevh.so,libjanus_rabbitmqevh.so"
	stats_period = 0
}
plugins: {
	disable = "libjanus_echotest.so,libjanus_recordplay.so,libjanus_sip.so,libjanus_videocall.so,libjanus_textroom.so,libjanus_recordplay.so,libjanus_nosip.so,libjanus_audiobridge.so"
}
transports: {
	disable = "libjanus_rabbitmq.so,libjanus_nanomsg.so,libjanus_pfunix.so"
}
